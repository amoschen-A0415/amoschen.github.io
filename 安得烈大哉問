// 大廳 60 秒倒數與補機器人機制
function startLobbyTimer() {
    if (lobbyInterval) clearInterval(lobbyInterval);
    lobbyTimer = 60;
    
    lobbyInterval = setInterval(() => {
        lobbyTimer--;
        broadcast({ type: 'LOBBY_TIMER', timer: lobbyTimer });

        // 時間到或人數滿 4 人，自動補齊 AI 並開賽
        if (lobbyTimer <= 0 || players.filter(p => !p.isAI).length >= 4) {
            clearInterval(lobbyInterval);
            fillRobotsAndStart();
        }
    }, 1000);
}

function fillRobotsAndStart() {
    const humanCount = players.filter(p => !p.isAI).length;
    const neededRobots = 4 - humanCount;
    
    const robotNames = ['🤖 AI 智庫', '⚡ AI 閃電手', '🎲 AI 運氣王', '🧠 AI 學霸'];
    for (let i = 0; i < neededRobots; i++) {
        players.push({
            id: 'robot_' + (i + 1),
            name: robotNames[i],
            isAI: true,
            score: 0,
            answered: false,
            choice: null,
            isQualified: true
        });
    }

    broadcast({ type: 'GAME_START', players: sanitizePlayers() });
    setTimeout(() => nextQuestion(), 2000);
}

// 廣播給所有連線用戶（大螢幕與手機）
function broadcast(data) {
    const msg = JSON.stringify(data);
    wss.clients.forEach(client => {
        if (client.readyState === WebSocket.OPEN) {
            client.send(msg);
        }
    });
}

function sanitizePlayers() {
    return players.map(p => ({
        id: p.id,
        name: p.name,
        isAI: p.isAI,
        score: p.score,
        answered: p.answered,
        isQualified: p.isQualified
    }));
}

// WebSocket 監聽事件
wss.on('connection', (ws) => {
    ws.on('message', (message) => {
        const data = JSON.parse(message);

        // 玩家掃碼登錄暱稱
        if (data.type === 'JOIN') {
            if (players.filter(p => !p.isAI).length >= 4) {
                ws.send(JSON.stringify({ type: 'ERROR', message: '房間已滿！' }));
                return;
            }
            const newPlayer = {
                id: 'player_' + Date.now(),
                name: data.name || '玩家 ' + (players.length + 1),
                isAI: false,
                score: 0,
                answered: false,
                choice: null,
                isQualified: true,
                ws: ws
            };
            players.push(newPlayer);
            ws.send(JSON.stringify({ type: 'JOIN_SUCCESS', player: { id: newPlayer.id, name: newPlayer.name } }));
            
            if (players.filter(p => !p.isAI).length === 1) {
                startLobbyTimer(); // 第一個人加入開始倒數 60 秒
            }

            broadcast({ type: 'PLAYER_UPDATE', players: sanitizePlayers() });
        }

        // 玩家手機點擊選擇題答案
        if (data.type === 'SUBMIT_ANSWER') {
            const player = players.find(p => p.id === data.playerId);
            if (player && !player.answered && player.isQualified) {
                player.answered = true;
                player.choice = data.choice;
                broadcast({ type: 'PLAYER_UPDATE', players: sanitizePlayers() });
            }
        }
    });
});

const PORT = process.env.PORT || 3000;
server.listen(PORT, () => console.log(`Server running on port ${PORT}`));
